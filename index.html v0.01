<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DiffView Studio | Comparador Antes & Depois Compartilhável</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- LZ-String para compressão de URL -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lz-string/1.5.0/lz-string.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #09090b;
            color: #fafafa;
            overflow-x: hidden;
        }

        /* Padrão quadriculado para imagens com transparência */
        .checkerboard {
            background-image: 
                linear-gradient(45deg, #18181b 25%, transparent 25%), 
                linear-gradient(-45deg, #18181b 25%, transparent 25%), 
                linear-gradient(45deg, transparent 75%, #18181b 75%), 
                linear-gradient(-45deg, transparent 75%, #18181b 75%);
            background-size: 20px 20px;
            background-position: 0 0, 0 10px, 10px -10px, -10px 0;
        }

        /* Container de comparação */
        .comparison-container {
            position: relative;
            user-select: none;
            touch-action: pan-y;
            overflow: hidden;
        }

        .img-overlay {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            overflow: hidden;
        }

        .slider-handle {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #ffffff;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.85);
            cursor: ew-resize;
            z-index: 30;
            transform: translateX(-50%);
        }

        .slider-button {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 44px;
            height: 44px;
            border-radius: 9999px;
            background: #ffffff;
            color: #09090b;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.65);
            transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
        }

        .slider-handle:hover .slider-button,
        .slider-handle.active .slider-button {
            transform: translate(-50%, -50%) scale(1.1);
            background: #3b82f6;
            color: #ffffff;
        }

        /* Animação do Toast */
        @keyframes slideUp {
            from { transform: translate(-50%, 100%); opacity: 0; }
            to { transform: translate(-50%, 0); opacity: 1; }
        }
        .toast-enter {
            animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Cabeçalho Principal -->
    <header class="border-b border-zinc-800/80 bg-zinc-950/85 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center shadow-lg shadow-blue-600/25">
                    <i data-lucide="split-square-horizontal" class="w-5 h-5 text-white"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg tracking-tight text-white leading-none">DiffView <span class="text-blue-500">Studio</span></h1>
                    <p class="text-[11px] text-zinc-400 mt-0.5 hidden sm:block">Comparador Visual & Compartilhamento por Link</p>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
                <button id="btnNewComparison" onclick="resetApp()" class="hidden px-3 py-2 text-xs sm:text-sm font-medium text-zinc-300 hover:text-white bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded-xl transition flex items-center gap-2">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>Nova Comparação</span>
                </button>

                <button id="btnShareLink" onclick="generateAndCopyLink()" disabled class="px-4 py-2 text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 disabled:bg-zinc-800 disabled:text-zinc-500 disabled:cursor-not-allowed rounded-xl shadow-lg shadow-blue-600/20 disabled:shadow-none transition flex items-center gap-2">
                    <i data-lucide="link" class="w-4 h-4"></i>
                    <span id="shareBtnText">Gerar Link Curto</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Área Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 flex flex-col gap-6">

        <!-- Banner Modo Cliente (Ativado automaticamente ao abrir um link compartilhado) -->
        <div id="sharedModeBanner" class="hidden bg-blue-950/40 border border-blue-800/50 rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-blue-500/20 rounded-xl text-blue-400 shrink-0">
                    <i data-lucide="eye" class="w-5 h-5"></i>
                </div>
                <div>
                    <h2 class="text-sm font-semibold text-blue-100">Visualização Compartilhada</h2>
                    <p class="text-xs text-blue-300/80">Arraste a barra central para comparar o Antes e o Depois.</p>
                </div>
            </div>
            <button onclick="exitSharedMode()" class="px-3.5 py-2 text-xs font-medium bg-blue-600 hover:bg-blue-500 text-white rounded-xl transition whitespace-nowrap">
                Editar Rótulos ou Criar Nova
            </button>
        </div>

        <!-- Painel de Configuração e Upload -->
        <section id="editorPanel" class="grid grid-cols-1 lg:grid-cols-12 gap-4 bg-zinc-900/50 border border-zinc-800/80 p-4 sm:p-5 rounded-2xl">
            
            <!-- Card Upload: ANTES -->
            <div class="lg:col-span-4 flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-semibold uppercase tracking-wider text-zinc-400">1. Imagem Original</label>
                    <input type="text" id="labelBeforeInput" value="ANTES" maxlength="20" oninput="updateLabels()" class="bg-zinc-950 border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-zinc-200 w-28 text-right focus:outline-none focus:border-blue-500" placeholder="Rótulo Antes">
                </div>
                <label id="dropzoneBefore" class="relative group cursor-pointer flex flex-col items-center justify-center h-28 border-2 border-dashed border-zinc-700 hover:border-blue-500 bg-zinc-950/60 hover:bg-zinc-900/80 rounded-xl transition overflow-hidden">
                    <input type="file" id="fileBefore" accept="image/*" class="hidden" onchange="handleImageUpload(event, 'before')">
                    <img id="thumbBefore" alt="Miniatura Antes" class="hidden absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-20 transition">
                    <div class="relative z-10 flex flex-col items-center text-center px-3">
                        <i data-lucide="upload-cloud" class="w-6 h-6 text-zinc-400 group-hover:text-blue-400 mb-1 transition"></i>
                        <span id="statusBefore" class="text-xs font-medium text-zinc-300 truncate max-w-[200px]">Clique ou arraste a imagem</span>
                        <span class="text-[10px] text-zinc-500 mt-0.5">JPG, PNG, WebP</span>
                    </div>
                </label>
            </div>

            <!-- Card Upload: DEPOIS -->
            <div class="lg:col-span-4 flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-semibold uppercase tracking-wider text-zinc-400">2. Imagem Modificada</label>
                    <input type="text" id="labelAfterInput" value="DEPOIS" maxlength="20" oninput="updateLabels()" class="bg-zinc-950 border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-zinc-200 w-28 text-right focus:outline-none focus:border-blue-500" placeholder="Rótulo Depois">
                </div>
                <label id="dropzoneAfter" class="relative group cursor-pointer flex flex-col items-center justify-center h-28 border-2 border-dashed border-zinc-700 hover:border-blue-500 bg-zinc-950/60 hover:bg-zinc-900/80 rounded-xl transition overflow-hidden">
                    <input type="file" id="fileAfter" accept="image/*" class="hidden" onchange="handleImageUpload(event, 'after')">
                    <img id="thumbAfter" alt="Miniatura Depois" class="hidden absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-20 transition">
                    <div class="relative z-10 flex flex-col items-center text-center px-3">
                        <i data-lucide="upload-cloud" class="w-6 h-6 text-zinc-400 group-hover:text-blue-400 mb-1 transition"></i>
                        <span id="statusAfter" class="text-xs font-medium text-zinc-300 truncate max-w-[200px]">Clique ou arraste a imagem</span>
                        <span class="text-[10px] text-zinc-500 mt-0.5">JPG, PNG, WebP</span>
                    </div>
                </label>
            </div>

            <!-- Card Otimização do Link -->
            <div class="lg:col-span-4 flex flex-col justify-between bg-zinc-950/70 border border-zinc-800/80 rounded-xl p-3.5">
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-xs font-semibold text-zinc-300 flex items-center gap-1.5">
                            <i data-lucide="cloud" class="w-3.5 h-3.5 text-blue-400"></i>
                            Link Curto em Nuvem
                        </span>
                        <span id="linkSizeBadge" class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-zinc-800 text-zinc-400">Aguardando imagens</span>
                    </div>
                    <p class="text-[11px] text-zinc-500 leading-relaxed">
                        Salva a comparação em nuvem anônima gratuita (365 dias) e gera uma URL curta ideal para WhatsApp.
                    </p>
                </div>

                <div class="mt-3 pt-2.5 border-t border-zinc-800/80 flex items-center justify-between gap-2">
                    <label for="resolutionPreset" class="text-[11px] text-zinc-400 whitespace-nowrap">Qualidade:</label>
                    <select id="resolutionPreset" onchange="reprocessImages()" class="bg-zinc-900 border border-zinc-700 text-zinc-200 text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-blue-500 w-full">
                        <option value="1280">Full HD Alta Nitidez (Recomendado)</option>
                        <option value="900">HD Equilibrado</option>
                        <option value="600">Compacto (Carregamento Instantâneo)</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- Barra Dedicada de Link Compartilhável (URL Curta) -->
        <section id="shareBarPanel" class="hidden bg-zinc-900/80 border border-blue-500/30 rounded-2xl p-3.5 sm:p-4 shadow-lg shadow-blue-950/20 transition-all">
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                <div class="flex items-center gap-2 text-blue-400 shrink-0">
                    <div class="p-2 bg-blue-500/15 rounded-xl">
                        <i data-lucide="share-2" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <span class="text-xs font-semibold text-zinc-100 block leading-tight">Link Curto da Comparação</span>
                        <span id="shareBarSubtitle" class="text-[10px] text-zinc-400 block">Clique em "Gerar Link Curto" para publicar</span>
                    </div>
                </div>

                <div class="flex-1 flex items-center gap-2">
                    <input 
                        type="text" 
                        id="shareLinkInput" 
                        readonly 
                        onclick="this.select(); this.setSelectionRange(0, 999999);" 
                        class="w-full bg-zinc-950 border border-zinc-700/90 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 rounded-xl px-3 py-2 text-xs text-blue-300 font-mono select-all focus:outline-none transition"
                        placeholder="Clique em 'Gerar Link Curto' ao lado..."
                    >
                    <button 
                        type="button" 
                        id="btnCopyDirectInput" 
                        onclick="generateAndCopyLink()" 
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-500 active:scale-[0.98] text-white text-xs font-semibold rounded-xl shadow-md shadow-blue-600/20 transition flex items-center gap-1.5 whitespace-nowrap shrink-0"
                    >
                        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                        <span id="copyDirectBtnText">Gerar & Copiar</span>
                    </button>
                </div>
            </div>
            <p id="manualCopyHint" class="hidden text-[11px] text-amber-400 mt-2 flex items-center gap-1.5">
                <i data-lucide="info" class="w-3.5 h-3.5 shrink-0"></i>
                <span>Seu navegador bloqueou a cópia automática. O link curto já está selecionado acima — pressione <strong>Ctrl+C</strong> (ou <strong>Cmd+C</strong>) para copiar.</span>
            </p>
        </section>

        <!-- Palco Interativo de Comparação -->
        <section class="flex-1 flex flex-col items-center justify-center bg-zinc-900/30 border border-zinc-800/80 rounded-2xl p-3 sm:p-6 min-h-[420px] relative">
            
            <!-- Estado Inicial Vazio -->
            <div id="emptyState" class="text-center max-w-md py-12 px-4">
                <div class="w-16 h-16 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center mx-auto mb-4 text-zinc-500">
                    <i data-lucide="images" class="w-8 h-8"></i>
                </div>
                <h3 class="text-base font-semibold text-zinc-200">Pronto para comparar</h3>
                <p class="text-xs sm:text-sm text-zinc-400 mt-1.5 leading-relaxed">
                    Envie a imagem <strong>Antes</strong> e a imagem <strong>Depois</strong> acima para habilitar o comparador interativo e gerar o link compartilhável.
                </p>
                <button onclick="loadDemoImages()" class="mt-5 px-4 py-2.5 text-xs font-medium text-blue-400 hover:text-blue-300 bg-blue-500/10 hover:bg-blue-500/20 border border-blue-500/20 rounded-xl transition inline-flex items-center gap-2">
                    <i data-lucide="sparkles" class="w-4 h-4"></i>
                    Carregar Exemplo Demonstrativo
                </button>
            </div>

            <!-- Visualizador Ativo -->
            <div id="stageWrapper" class="hidden w-full flex flex-col items-center">
                
                <!-- Controles Rápidos do Palco -->
                <div class="w-full max-w-4xl flex flex-wrap items-center justify-between gap-2 mb-3 px-1">
                    <div class="flex items-center gap-1.5 sm:gap-2">
                        <button onclick="setSliderPosition(0)" class="px-2.5 py-1.5 text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg transition">100% Depois</button>
                        <button onclick="setSliderPosition(50)" class="px-2.5 py-1.5 text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg transition">50% / 50%</button>
                        <button onclick="setSliderPosition(100)" class="px-2.5 py-1.5 text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg transition">100% Antes</button>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-zinc-400">
                        <span id="dimensionsInfo" class="font-mono text-[11px]"></span>
                        <button onclick="toggleFullscreen()" class="p-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded-lg transition" title="Tela Cheia">
                            <i data-lucide="maximize-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <!-- Caixa de Comparação Pixel-a-Pixel -->
                <div id="comparisonBox" class="comparison-container checkerboard rounded-xl shadow-2xl border border-zinc-700/70 max-w-full" style="max-height: 72vh;">
                    
                    <!-- Camada Base: DEPOIS (Visível à direita) -->
                    <img id="imgAfterDisplay" src="" alt="Depois" class="block max-w-full max-h-[72vh] w-auto h-auto object-contain pointer-events-none select-none">

                    <!-- Rótulo DEPOIS -->
                    <span id="badgeAfter" class="absolute top-3 right-3 z-20 px-2.5 py-1 rounded-lg text-xs font-bold tracking-wider uppercase bg-black/65 text-white backdrop-blur-md border border-white/10 pointer-events-none">
                        DEPOIS
                    </span>

                    <!-- Camada Superior: ANTES (Recortada via clip-path) -->
                    <div id="beforeOverlay" class="img-overlay" style="clip-path: inset(0 50% 0 0);">
                        <img id="imgBeforeDisplay" src="" alt="Antes" class="block w-full h-full object-contain pointer-events-none select-none">
                        
                        <!-- Rótulo ANTES -->
                        <span id="badgeBefore" class="absolute top-3 left-3 z-20 px-2.5 py-1 rounded-lg text-xs font-bold tracking-wider uppercase bg-black/65 text-white backdrop-blur-md border border-white/10 pointer-events-none">
                            ANTES
                        </span>
                    </div>

                    <!-- Barra Deslizante -->
                    <div id="sliderHandle" class="slider-handle" style="left: 50%;">
                        <div class="slider-button">
                            <i data-lucide="chevrons-left-right" class="w-5 h-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Notificação Toast -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden">
        <div class="bg-zinc-900 border border-zinc-700 text-white px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3">
            <div id="toastIcon" class="text-emerald-400 shrink-0">
                <i data-lucide="check-circle-2" class="w-5 h-5"></i>
            </div>
            <div>
                <p id="toastTitle" class="text-sm font-semibold">Link copiado!</p>
                <p id="toastSubtitle" class="text-xs text-zinc-400">Envie para seu cliente visualizar o Antes e Depois.</p>
            </div>
        </div>
    </div>

    <script>
        // Inicializa ícones Lucide
        lucide.createIcons();

        // Estado global da aplicação
        const state = {
            rawBefore: null,
            rawAfter: null,
            optimizedBefore: null,
            optimizedAfter: null,
            labelBefore: 'ANTES',
            labelAfter: 'DEPOIS',
            sliderPercent: 50,
            isDragging: false,
            cachedShortUrl: null,
            isUploading: false
        };

        // Referências DOM
        const comparisonBox = document.getElementById('comparisonBox');
        const beforeOverlay = document.getElementById('beforeOverlay');
        const sliderHandle = document.getElementById('sliderHandle');
        const imgBeforeDisplay = document.getElementById('imgBeforeDisplay');
        const imgAfterDisplay = document.getElementById('imgAfterDisplay');

        // ==========================================
        // 1. INICIALIZAÇÃO E LEITURA DA URL (CURTA #id= OU LEGADA #cmp=)
        // ==========================================
        window.addEventListener('DOMContentLoaded', () => {
            setupDragAndDrop('dropzoneBefore', 'before');
            setupDragAndDrop('dropzoneAfter', 'after');
            setupSliderEvents();
            checkUrlForSharedData();
        });

        window.addEventListener('hashchange', checkUrlForSharedData);

        async function checkUrlForSharedData() {
            const hash = window.location.hash;

            // Novo formato curto via nuvem gratuita (#id=XXXXXXXXX)
            if (hash && hash.startsWith('#id=')) {
                const pasteId = hash.replace('#id=', '').trim();
                if (!pasteId) return;

                try {
                    showToast('Carregando comparação...', 'Baixando imagens da nuvem em alta definição.');
                    const response = await fetch(`https://dpaste.com/${pasteId}.txt`);
                    if (!response.ok) throw new Error('Comparação não encontrada ou expirada.');

                    const rawText = await response.text();
                    const payload = JSON.parse(rawText);

                    if (payload.b && payload.a) {
                        applyLoadedPayload(payload, `${window.location.href.split('#')[0]}#id=${pasteId}`);
                    }
                } catch (err) {
                    console.error('Erro ao carregar link curto:', err);
                    showToast('Link indisponível', 'Não foi possível carregar esta comparação.', 'error');
                }
                return;
            }

            // Suporte retrocompatível para links antigos (#cmp=...)
            if (hash && hash.startsWith('#cmp=')) {
                try {
                    const compressed = hash.replace('#cmp=', '');
                    const jsonStr = LZString.decompressFromEncodedURIComponent(compressed);
                    if (!jsonStr) throw new Error('Falha na descompressão');

                    const payload = JSON.parse(jsonStr);
                    if (payload.b && payload.a) {
                        applyLoadedPayload(payload, window.location.href);
                    }
                } catch (err) {
                    console.error('Erro ao ler URL:', err);
                    showToast('Link inválido ou incompleto', 'Não foi possível carregar as imagens desta URL.', 'error');
                }
            }
        }

        function applyLoadedPayload(payload, currentUrl) {
            state.rawBefore = payload.b;
            state.rawAfter = payload.a;
            state.optimizedBefore = payload.b;
            state.optimizedAfter = payload.a;
            state.labelBefore = payload.lb || 'ANTES';
            state.labelAfter = payload.la || 'DEPOIS';
            state.cachedShortUrl = currentUrl;

            document.getElementById('labelBeforeInput').value = state.labelBefore;
            document.getElementById('labelAfterInput').value = state.labelAfter;
            updateLabels();

            // Ativa visualização limpa para o cliente
            document.getElementById('editorPanel').classList.add('hidden');
            document.getElementById('sharedModeBanner').classList.remove('hidden');
            document.getElementById('btnNewComparison').classList.remove('hidden');

            renderComparisonStage();
            document.getElementById('shareLinkInput').value = currentUrl;
            document.getElementById('shareBarSubtitle').textContent = `Link curto ativo (${currentUrl.length} caracteres)`;
            updateLinkStatusBadge();
        }

        function exitSharedMode() {
            document.getElementById('editorPanel').classList.remove('hidden');
            document.getElementById('sharedModeBanner').classList.add('hidden');
        }

        function resetApp() {
            try {
                window.history.pushState("", document.title, window.location.pathname + window.location.search);
            } catch (e) {
                window.location.hash = '';
            }
            
            state.rawBefore = null;
            state.rawAfter = null;
            state.optimizedBefore = null;
            state.optimizedAfter = null;
            state.cachedShortUrl = null;
            
            document.getElementById('fileBefore').value = '';
            document.getElementById('fileAfter').value = '';
            document.getElementById('thumbBefore').classList.add('hidden');
            document.getElementById('thumbAfter').classList.add('hidden');
            document.getElementById('statusBefore').textContent = 'Clique ou arraste a imagem';
            document.getElementById('statusAfter').textContent = 'Clique ou arraste a imagem';
            
            document.getElementById('stageWrapper').classList.add('hidden');
            document.getElementById('emptyState').classList.remove('hidden');
            document.getElementById('editorPanel').classList.remove('hidden');
            document.getElementById('sharedModeBanner').classList.add('hidden');
            document.getElementById('btnNewComparison').classList.add('hidden');
            document.getElementById('shareBarPanel').classList.add('hidden');
            document.getElementById('manualCopyHint').classList.add('hidden');
            document.getElementById('shareLinkInput').value = '';
            document.getElementById('btnShareLink').disabled = true;
            document.getElementById('linkSizeBadge').textContent = 'Aguardando imagens';
            document.getElementById('linkSizeBadge').className = 'text-[10px] font-mono px-2 py-0.5 rounded-md bg-zinc-800 text-zinc-400';
        }

        // ==========================================
        // 2. UPLOAD E COMPRESSÃO INTELIGENTE
        // ==========================================
        function setupDragAndDrop(zoneId, side) {
            const zone = document.getElementById(zoneId);
            if (!zone) return;

            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(evt => {
                zone.addEventListener(evt, e => {
                    e.preventDefault();
                    e.stopPropagation();
                });
            });

            zone.addEventListener('dragover', () => zone.classList.add('border-blue-500', 'bg-zinc-900'));
            zone.addEventListener('dragleave', () => zone.classList.remove('border-blue-500', 'bg-zinc-900'));
            zone.addEventListener('drop', e => {
                zone.classList.remove('border-blue-500', 'bg-zinc-900');
                const file = e.dataTransfer.files[0];
                if (file && file.type.startsWith('image/')) {
                    processFile(file, side);
                }
            });
        }

        function handleImageUpload(event, side) {
            const file = event.target.files[0];
            if (file) processFile(file, side);
        }

        function processFile(file, side) {
            const reader = new FileReader();
            reader.onload = (e) => {
                const dataUrl = e.target.result;
                if (side === 'before') {
                    state.rawBefore = dataUrl;
                    document.getElementById('thumbBefore').src = dataUrl;
                    document.getElementById('thumbBefore').classList.remove('hidden');
                    document.getElementById('statusBefore').textContent = file.name;
                } else {
                    state.rawAfter = dataUrl;
                    document.getElementById('thumbAfter').src = dataUrl;
                    document.getElementById('thumbAfter').classList.remove('hidden');
                    document.getElementById('statusAfter').textContent = file.name;
                }
                reprocessImages();
            };
            reader.readAsDataURL(file);
        }

        function compressImageForUrl(dataUrl, maxDimension = 900, quality = 0.78) {
            return new Promise((resolve) => {
                const img = new Image();
                img.onload = () => {
                    let width = img.width;
                    let height = img.height;

                    if (width > maxDimension || height > maxDimension) {
                        if (width > height) {
                            height = Math.round((height * maxDimension) / width);
                            width = maxDimension;
                        } else {
                            width = Math.round((width * maxDimension) / height);
                            height = maxDimension;
                        }
                    }

                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    const compressed = canvas.toDataURL('image/webp', quality);
                    resolve({ dataUrl: compressed, width, height });
                };
                img.src = dataUrl;
            });
        }

        async function reprocessImages() {
            const maxDim = parseInt(document.getElementById('resolutionPreset').value, 10);
            const quality = maxDim >= 1200 ? 0.85 : (maxDim >= 900 ? 0.82 : 0.78);

            // Invalida o link curto anterior pois a imagem/qualidade mudou
            state.cachedShortUrl = null;

            if (state.rawBefore) {
                const resB = await compressImageForUrl(state.rawBefore, maxDim, quality);
                state.optimizedBefore = resB.dataUrl;
            }
            if (state.rawAfter) {
                const resA = await compressImageForUrl(state.rawAfter, maxDim, quality);
                state.optimizedAfter = resA.dataUrl;
            }

            if (state.optimizedBefore && state.optimizedAfter) {
                renderComparisonStage();
                updateLinkStatusBadge();
            }
        }

        // ==========================================
        // 3. RENDERIZAÇÃO E CONTROLE DO SLIDER
        // ==========================================
        function renderComparisonStage() {
            document.getElementById('emptyState').classList.add('hidden');
            document.getElementById('stageWrapper').classList.remove('hidden');
            document.getElementById('shareBarPanel').classList.remove('hidden');
            document.getElementById('btnShareLink').disabled = false;
            document.getElementById('btnNewComparison').classList.remove('hidden');

            imgAfterDisplay.src = state.optimizedAfter;
            imgBeforeDisplay.src = state.optimizedBefore;

            if (!state.cachedShortUrl) {
                document.getElementById('shareLinkInput').value = '';
                document.getElementById('shareBarSubtitle').textContent = 'Pronto para gerar URL curta (~65 caracteres)';
            }

            imgAfterDisplay.onload = () => {
                document.getElementById('dimensionsInfo').textContent = 
                    `${imgAfterDisplay.naturalWidth} × ${imgAfterDisplay.naturalHeight}px`;
                setSliderPosition(state.sliderPercent);
            };
        }

        function updateLabels() {
            state.labelBefore = document.getElementById('labelBeforeInput').value || 'ANTES';
            state.labelAfter = document.getElementById('labelAfterInput').value || 'DEPOIS';
            document.getElementById('badgeBefore').textContent = state.labelBefore;
            document.getElementById('badgeAfter').textContent = state.labelAfter;
            state.cachedShortUrl = null;
            if (state.optimizedBefore && state.optimizedAfter) {
                document.getElementById('shareLinkInput').value = '';
                document.getElementById('shareBarSubtitle').textContent = 'Rótulo alterado — clique em Gerar & Copiar para atualizar';
            }
        }

        function setSliderPosition(percent) {
            const clamped = Math.max(0, Math.min(100, percent));
            state.sliderPercent = clamped;
            sliderHandle.style.left = `${clamped}%`;
            beforeOverlay.style.clipPath = `inset(0 ${100 - clamped}% 0 0)`;
        }

        function setupSliderEvents() {
            const updateFromClientX = (clientX) => {
                const rect = comparisonBox.getBoundingClientRect();
                if (rect.width === 0) return;
                const x = clientX - rect.left;
                const percent = (x / rect.width) * 100;
                setSliderPosition(percent);
            };

            comparisonBox.addEventListener('mousedown', (e) => {
                state.isDragging = true;
                sliderHandle.classList.add('active');
                updateFromClientX(e.clientX);
            });

            window.addEventListener('mousemove', (e) => {
                if (!state.isDragging) return;
                updateFromClientX(e.clientX);
            });

            window.addEventListener('mouseup', () => {
                if (state.isDragging) {
                    state.isDragging = false;
                    sliderHandle.classList.remove('active');
                }
            });

            comparisonBox.addEventListener('touchstart', (e) => {
                state.isDragging = true;
                sliderHandle.classList.add('active');
                if (e.touches.length > 0) {
                    updateFromClientX(e.touches[0].clientX);
                }
            }, { passive: true });

            window.addEventListener('touchmove', (e) => {
                if (!state.isDragging) return;
                if (e.touches.length > 0) {
                    updateFromClientX(e.touches[0].clientX);
                }
            }, { passive: true });

            window.addEventListener('touchend', () => {
                state.isDragging = false;
                sliderHandle.classList.remove('active');
            });
        }

        // ==========================================
        // 4. GERAÇÃO DE LINK CURTO VIA NUVEM ANÔNIMA GRATUITA
        // ==========================================
        function buildFallbackLongUrl() {
            const payload = {
                b: state.optimizedBefore,
                a: state.optimizedAfter,
                lb: state.labelBefore,
                la: state.labelAfter
            };
            const compressed = LZString.compressToEncodedURIComponent(JSON.stringify(payload));
            const baseUrl = window.location.href.split('#')[0];
            return `${baseUrl}#cmp=${compressed}`;
        }

        function updateLinkStatusBadge() {
            const badge = document.getElementById('linkSizeBadge');
            if (state.cachedShortUrl) {
                badge.className = 'text-[10px] font-mono px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
                badge.textContent = `URL Curta • ${state.cachedShortUrl.length} caracteres`;
            } else {
                badge.className = 'text-[10px] font-mono px-2 py-0.5 rounded-md bg-blue-500/20 text-blue-400 border border-blue-500/30';
                badge.textContent = 'Pronto p/ Link Curto';
            }
        }

        async function publishToFreeCloud() {
            if (state.cachedShortUrl) return state.cachedShortUrl;

            const payload = JSON.stringify({
                b: state.optimizedBefore,
                a: state.optimizedAfter,
                lb: state.labelBefore,
                la: state.labelAfter
            });

            // API pública e gratuita do dpaste.com (aceita CORS e retorna ID curto de 9 caracteres)
            const formData = new URLSearchParams();
            formData.append('content', payload);
            formData.append('syntax', 'json');
            formData.append('expiry_days', '365');

            const response = await fetch('https://dpaste.com/api/v2/', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: formData.toString()
            });

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            // A API retorna a URL criada (ex: https://dpaste.com/ABCD12345)
            const createdUrl = (await response.text()).trim();
            const pasteId = createdUrl.split('/').filter(Boolean).pop();

            if (!pasteId) throw new Error('ID inválido retornado pela API');

            const baseUrl = window.location.href.split('#')[0];
            const shortUrl = `${baseUrl}#id=${pasteId}`;
            state.cachedShortUrl = shortUrl;
            return shortUrl;
        }

        async function generateAndCopyLink() {
            if (!state.optimizedBefore || !state.optimizedAfter || state.isUploading) return;

            const headerBtnText = document.getElementById('shareBtnText');
            const directBtnText = document.getElementById('copyDirectBtnText');
            const inputEl = document.getElementById('shareLinkInput');
            const hintEl = document.getElementById('manualCopyHint');

            state.isUploading = true;
            if (headerBtnText) headerBtnText.textContent = 'Gerando Link Curto...';
            if (directBtnText) directBtnText.textContent = 'Gerando...';

            let shareUrl = '';
            let isShort = false;

            try {
                shareUrl = await publishToFreeCloud();
                isShort = true;
            } catch (err) {
                console.warn('Falha na nuvem gratuita, usando fallback local:', err);
                shareUrl = buildFallbackLongUrl();
            } finally {
                state.isUploading = false;
            }

            if (inputEl) inputEl.value = shareUrl;
            updateLinkStatusBadge();

            if (isShort) {
                document.getElementById('shareBarSubtitle').textContent = `Link curto gerado com sucesso (${shareUrl.length} caracteres)`;
            } else {
                document.getElementById('shareBarSubtitle').textContent = 'Modo offline (sem conexão com nuvem gratuita)';
            }

            // Atualiza a URL no navegador sem recarregar
            try {
                const hashPart = `#${shareUrl.split('#')[1]}`;
                if (window.location.protocol !== 'about:' && window.location.origin !== 'null') {
                    window.history.replaceState(null, '', hashPart);
                }
            } catch (e) {}

            // Cópia em múltiplas camadas
            let copied = false;
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(shareUrl);
                    copied = true;
                }
            } catch (err) {
                copied = false;
            }

            if (!copied && inputEl) {
                inputEl.focus();
                inputEl.select();
                inputEl.setSelectionRange(0, 999999);
                try {
                    copied = document.execCommand('copy');
                } catch (err) {
                    copied = false;
                }
            }

            if (copied) {
                if (hintEl) hintEl.classList.add('hidden');
                if (inputEl) inputEl.classList.remove('border-amber-500', 'ring-2', 'ring-amber-500/40');

                if (headerBtnText) headerBtnText.textContent = 'Link Curto Copiado!';
                if (directBtnText) directBtnText.textContent = 'Copiado!';

                setTimeout(() => {
                    if (headerBtnText) headerBtnText.textContent = 'Gerar Link Curto';
                    if (directBtnText) directBtnText.textContent = 'Gerar & Copiar';
                }, 2500);

                showToast(
                    isShort ? `Link curto copiado (${shareUrl.length} caracteres)!` : 'Link copiado!',
                    'Pronto para colar e enviar no WhatsApp do seu cliente.'
                );
            } else if (inputEl) {
                if (headerBtnText) headerBtnText.textContent = 'Gerar Link Curto';
                if (directBtnText) directBtnText.textContent = 'Gerar & Copiar';

                inputEl.focus();
                inputEl.select();
                inputEl.setSelectionRange(0, 999999);
                inputEl.classList.add('border-amber-500', 'ring-2', 'ring-amber-500/40');
                if (hintEl) hintEl.classList.remove('hidden');

                showToast(
                    'Link curto selecionado!',
                    'Pressione Ctrl+C (ou Cmd+C) para copiar o link destacado.',
                    'error'
                );
            }
        }

        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                comparisonBox.requestFullscreen().catch(() => {});
            } else {
                document.exitFullscreen();
            }
        }

        function showToast(title, subtitle, type = 'success') {
            const toast = document.getElementById('toast');
            const icon = document.getElementById('toastIcon');
            document.getElementById('toastTitle').textContent = title;
            document.getElementById('toastSubtitle').textContent = subtitle;

            icon.className = type === 'error' ? 'text-rose-400 shrink-0' : 'text-emerald-400 shrink-0';
            toast.classList.remove('hidden');
            toast.classList.add('toast-enter');

            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => {
                toast.classList.add('hidden');
            }, 4000);
        }

        // ==========================================
        // 5. GERADOR DE EXEMPLO DEMONSTRATIVO
        // ==========================================
        function loadDemoImages() {
            const createDemoCanvas = (isAfter) => {
                const c = document.createElement('canvas');
                c.width = 900;
                c.height = 540;
                const ctx = c.getContext('2d');

                const grad = ctx.createLinearGradient(0, 0, 900, 540);
                if (!isAfter) {
                    grad.addColorStop(0, '#3f3f46');
                    grad.addColorStop(1, '#18181b');
                } else {
                    grad.addColorStop(0, '#1d4ed8');
                    grad.addColorStop(0.5, '#4f46e5');
                    grad.addColorStop(1, '#0f172a');
                }
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, 900, 540);

                ctx.fillStyle = isAfter ? 'rgba(255,255,255,0.14)' : 'rgba(255,255,255,0.04)';
                ctx.beginPath();
                ctx.arc(450, 270, 180, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 40px Inter, sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(isAfter ? 'VERSÃO FINAL TRATADA' : 'ARQUIVO ORIGINAL BRUTO', 450, 260);

                ctx.font = '19px Inter, sans-serif';
                ctx.fillStyle = isAfter ? '#93c5fd' : '#a1a1aa';
                ctx.fillText(isAfter ? 'Cores calibradas • Contraste otimizado • Nitidez HD' : 'Sem correção de cor • Iluminação neutra', 450, 305);

                return c.toDataURL('image/webp', 0.85);
            };

            state.rawBefore = createDemoCanvas(false);
            state.rawAfter = createDemoCanvas(true);
            
            document.getElementById('thumbBefore').src = state.rawBefore;
            document.getElementById('thumbBefore').classList.remove('hidden');
            document.getElementById('statusBefore').textContent = 'exemplo_antes.webp';

            document.getElementById('thumbAfter').src = state.rawAfter;
            document.getElementById('thumbAfter').classList.remove('hidden');
            document.getElementById('statusAfter').textContent = 'exemplo_depois.webp';

            reprocessImages();
        }
    </script>
</body>
</html>
